{
  "name": "butterchurn-visualizer",
  "version": "1.9.0",
  "description": "Milkdrop (butterchurn) audio visualizer pages for OBS and standalone browser use.",
  "private": true,
  "scripts": {
    "start": "serve src",
    "dev": "python3 -m http.server --directory src 8000",
    "lint": "eslint . && python -m ruff check tools/",
    "test:js": "node --test tests/*.js",
    "test:py": "python3 -m unittest discover -s tests",
    "test": "npm run test:js && npm run test:py",
    "validate:presets": "node tools/validate-preset-chunks.js",
    "validate:exp": "node tools/validate-experimental-presets.js",
    "postinstall": "patch-package"
  },
  "keywords": [
    "butterchurn",
    "milkdrop",
    "audio-visualizer",
    "obs",
    "browser-source",
    "webgl"
  ],
  "license": "MIT",
  "overrides": {
    "lodash": ">=4.17.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "acorn": "8.18.0",
    "eslint": "10.8.0",
    "milkdrop-eel-parser": "0.0.4",
    "milkdrop-preset-utils": "0.2.1",
    "milkdrop-shader-converter": "0.0.8",
    "patch-package": "8.0.1",
    "serve": "14.2.6"
  }
}
